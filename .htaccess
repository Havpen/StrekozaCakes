# Production Unix hosting (Apache)
# Корень сайта = содержимое dist/ + папка api/

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Не трогаем API и реальные файлы
  RewriteRule ^api/ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# Запрет выполнения скриптов в uploads
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .cgi .pl
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phps
<FilesMatch "\.(?i:php|phtml|cgi|pl|phar)$">
  Require all denied
</FilesMatch>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(?i:php|phtml|cgi|pl|phar)$">
    Deny from all
  </FilesMatch>
</IfModule>
